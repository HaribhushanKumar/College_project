# =============================================================================
# University Fund Management & AI Validation System
# Department of Higher Education, Government of Karnataka
# Environment Configuration Template (.env.example)
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=karnataka_higher_education_fund_mgmt_jwt_secret_key_2024
JWT_EXPIRES_IN=24h

# Relational Database Configuration (SQLite local fallback)
DATABASE_PATH=./data/university_fund_mgmt.db

# Supabase Cloud Database (Project: college-fund-mgmt | Region: ap-northeast-2)
SUPABASE_PROJECT_ID=gkbrcbmwmdrsywfjinfp
SUPABASE_URL=https://gkbrcbmwmdrsywfjinfp.supabase.co
# Get these keys from https://supabase.com/dashboard/project/gkbrcbmwmdrsywfjinfp/settings/api
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Frontend Vite Supabase Bindings
VITE_SUPABASE_URL=https://gkbrcbmwmdrsywfjinfp.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# File Storage & Upload Parameters
UPLOAD_DIR=./server/uploads
MAX_UPLOAD_SIZE_MB=25

# Client Frontend API Binding
VITE_API_URL=http://localhost:5000/api

# Optional External ML Model Configuration
AI_MODEL_ENDPOINT=
AI_MODEL_API_KEY=
