# =============================================================================
# University Fund Management & AI Validation System
# Department of Higher Education, Government of Karnataka
# Environment Configuration Template (.env.example)
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=karnataka_higher_education_fund_mgmt_jwt_secret_key_2024
JWT_EXPIRES_IN=24h

# Relational Database Configuration (SQLite)
DATABASE_PATH=./data/university_fund_mgmt.db

# File Storage & Upload Parameters
UPLOAD_DIR=./server/uploads
MAX_UPLOAD_SIZE_MB=25

# Client Frontend API Binding
VITE_API_URL=http://localhost:5000/api

# Optional External ML Model Configuration
# When unconfigured, the system uses the built-in deterministic heuristics & Z-Score statistical sentinel
AI_MODEL_ENDPOINT=
AI_MODEL_API_KEY=
